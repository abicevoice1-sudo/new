# ⚠️ This file configures the LEGACY Node/Express server in `server/` (local dev
# only). The production runtime is the PHP/MariaDB API in `php-api/`, which has
# its OWN env file — copy `php-api/.env.example` → `php-api/.env` and fill that
# in for a cPanel deploy. The two are NOT interchangeable: this one is Postgres
# (5432) and Node, that one is MariaDB and PHP. The browser only needs
# VITE_API_URL; every other key below is read by `server/`, not by `php-api/`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shiarishta
DB_USER=postgres
DB_PASSWORD=postgres
# ── Frontend → API base URL ──────────────────────────────────────────────────
# Point this at the PHP API. `php -S 127.0.0.1:8091 index.php` → the value below;
# a cPanel deploy → https://api.yourdomain.com. Only this key is read by Vite.
VITE_API_URL=http://localhost:8080
PORT=8080
# ── Mail (required for email verification + password reset) ──
# cPanel → Email Accounts → create a mailbox, then fill these in.
# Without SMTP_* the links print to the server log (dev/e2e mode only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shiarishta <no-reply@yourdomain.com>
# Verification photos land here (keep OUTSIDE public_html so they are never
# web-served; they are read only through the admin-authenticated API route).
UPLOAD_DIR=./uploads
# ── Server runtime ──
# production: strict boot validation + HSTS; development: permissive
NODE_ENV=production
# Set to 0 only when NOT behind a reverse proxy. cPanel/nginx/LiteSpeed → keep 1
# so req.ip is the real client (rate limiting depends on it).
TRUST_PROXY=1
CLIENT_URL=http://localhost:5173
# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=7d
# First admin: this email becomes is_admin on register.
# The UI E2E (scripts/e2e-ui-claim.mjs) uses 'admin@shiarishta.com' as its
# fixed admin — add it here so the test can promote a matchmaker. Keep any
# production admin email here too.
ADMIN_EMAILS=admin@shiarishta.com
ADMIN_UIDS=comma_separated_admin_uids
ADMIN_SESSION_SECRET=replace_with_long_random_secret
NVIDIA_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
